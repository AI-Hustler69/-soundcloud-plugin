{
  "name": "soundcloud-dj-mcp",
  "version": "0.1.1",
  "description": "SoundCloud MCP server and Claude Code plugin: find free-download tracks, check Creative Commons licenses, and build DJ sets by BPM and Camelot key. Metadata and links only; never downloads or rips audio.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "soundcloud-dj-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist/server.js",
    "dist/THIRD_PARTY_LICENSES.txt",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "list-tools": "node scripts/list-tools.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-code-plugin",
    "anthropic",
    "soundcloud",
    "soundcloud-api",
    "dj",
    "dj-tools",
    "dj-set",
    "harmonic-mixing",
    "camelot",
    "bpm",
    "free-download",
    "creative-commons",
    "music-discovery",
    "drum-and-bass"
  ],
  "homepage": "https://github.com/AI-Hustler69/-soundcloud-plugin#readme",
  "bugs": {
    "url": "https://github.com/AI-Hustler69/-soundcloud-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Hustler69/-soundcloud-plugin.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
